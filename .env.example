# Paths are resolved relative to the repository root. Each run creates a
# UTC-timestamped subfolder beneath OUTPUT_DIR.
OUTPUT_DIR=output
DOCUMENTATION_DIR=documentation

# Only theatres at or below this displayed distance are offered.
MAX_DISTANCE_KM=50

# Browser configuration.
HEADLESS=false
BROWSER_CHANNEL=msedge
LOCALE=en-CA
TIMEZONE_ID=America/Toronto

# Optional browser geolocation. Set both values or leave both blank.
# The example coordinates are near central Toronto.
LATITUDE=43.6532
LONGITUDE=-79.3832
GEOLOCATION_ACCURACY_METERS=100
